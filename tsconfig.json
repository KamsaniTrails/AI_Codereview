{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ai-reviewer/core": ["./packages/core/src/index.ts"],
      "@ai-reviewer/github": ["./packages/github/src/index.ts"],
      "@ai-reviewer/db": ["./packages/db/src/index.ts"],
      "@ai-reviewer/llm": ["./packages/llm/src/index.ts"],
      "@ai-reviewer/analyzers": ["./packages/analyzers/src/index.ts"],
      "@ai-reviewer/indexer": ["./packages/indexer/src/index.ts"],
      "@ai-reviewer/retrieval": ["./packages/retrieval/src/index.ts"],
      "@ai-reviewer/agents": ["./packages/agents/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "evals/src"],
  "exclude": ["node_modules", "dist", "**/dist", "apps/dashboard/dist"]
}

