# Server & Environment
NODE_ENV=development
PORT=3000
DASHBOARD_PORT=5173
DASHBOARD_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Database (PostgreSQL 16 with pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_code_reviewer

# Redis (BullMQ queues: review and index)
REDIS_URL=redis://localhost:6379

# GitHub App Authentication
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=ai-code-reviewer-app
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_32_characters_long
GITHUB_PRIVATE_KEY=""
GITHUB_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpNSUlFcEFJQkFBS0NBUUVBe...
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
SESSION_SECRET=super_secret_session_crypto_key_for_cookies_minimum_32_chars

# Vite Frontend Variables
VITE_GITHUB_APP_SLUG=ai-code-reviewer-app

# LLM & Embedding Providers
# Options for LLM_PROVIDER: mock (default for offline dev/test), openai, gemini, anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
# Options for EMBEDDING_PROVIDER: mock (default), openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Provider API Keys (required when LLM_PROVIDER != mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local Webhook Tunnel (Smee.io)
SMEE_URL=https://smee.io/your-unique-channel-id

